# ── Secrets & sensitive local data ──────────────────────────────
# Never commit real credentials, generated passwords, or exported
# secrets from a live run against a real domain.
.env
.env.*
!.env.example
*.secret
*.secrets
*.credential
*.credentials
*.clixml
*.pfx
*.p12
*.pem
*.key
*.ppk
*.kdbx
id_rsa*
id_ed25519*
*.rdp
*password*.csv
*password*.txt
*_results.csv

# ── Real input data ─────────────────────────────────────────────
# Staff-name lists can be personal data. Commit a *.sample.* file with fake names instead.
names.txt
names.csv
!names.sample.*

# ── Runtime output from these scripts ───────────────────────────
# Audit logs and provisioning reports are generated locally each
# run and can contain real usernames/OU paths — don't publish them.
*.jsonl
*-Report.csv
output/
reports/
*.log
*.transcript
PowerShell_transcript.*

# ── Temp / backup files ──────────────────────────────────────────
*.tmp
*.temp
*.bak
*~

# ── Editor / IDE ──────────────────────────────────────────────────
.vscode/
.vs/
.idea/

# ── OS cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
~$*
